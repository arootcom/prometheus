      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "editorMode": "code",
          "expr": "node_cpu_info",
          "legendFormat": "{{model_name}} (Cores: {{core}}, Family: {{family}})",
          "range": true,
          "refId": "A"
